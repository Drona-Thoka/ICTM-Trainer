{
  "buildCommand": "cd ictm-reader && npm install && npm run build",
  "outputDirectory": "ictm-reader/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "**",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/index.html", "status": 404, "headers": { "Cache-Control": "no-store" } }
  ]
}
